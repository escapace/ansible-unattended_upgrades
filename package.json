{
  "name": "@escapace/ansible-unattended_upgrades",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/ansible-unattended_upgrades/issues",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@escapace/syncpack-configuration": "0.3.0",
    "@ls-lint/ls-lint": "2.3.1",
    "eslint": "10.10.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.76.0",
    "oxlint-config-escapace": "0.2.0",
    "syncpack": "15.3.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^12.17.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^26.13.0"
    }
  },
  "homepage": "https://github.com/escapace/ansible-unattended_upgrades#readme",
  "license": "Apache-2.0",
  "private": true,
  "repository": "escapace/ansible-unattended_upgrades",
  "scripts": {
    "format": "syncpack format && eslint --no-warn-ignored --fix && oxfmt",
    "lint": "ls-lint --config .ls-lint.yaml && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format"
  },
  "sideEffects": false,
  "type": "module"
}
